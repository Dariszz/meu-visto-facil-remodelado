# As páginas estáticas e db:validate/db:generate não precisam destas variáveis.
# Configure valores reais SOMENTE em .env.local (ignorado pelo Git).
# Supabase: aplicação pooled, role de leitura; migrations/seed Session pooler (5432).
# Copie a URL no painel Connect; use sslmode=verify-full e acrescente &schema=catalog.
# Não habilite Data API para o schema catalog. Nunca cole credenciais na conversa.
DATABASE_URL=
DIRECT_URL=
# Habilitar apenas no banco de desenvolvimento confirmado localmente.
DB_SEED_CONFIRM=

# Configure SOMENTE em .env.test.local, não em .env.local:
# TEST_DATABASE_URL= Session pooler (5432) do projeto Supabase exclusivo de TESTE,
# com sslmode=verify-full&schema=catalog.
# DB_TEST_CONFIRM=supabase:IDENTIFICADOR_DO_PROJETO_DE_TESTE
# O banco hospedado se chama postgres; catalog deve estar vazio antes do teste.
