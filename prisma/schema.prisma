generator client {
  provider = "prisma-client"
  output   = "../src/lib/db/generated"
}

datasource db {
  provider = "postgresql"
  schemas  = ["catalog"]
}

model UserProfile {
  id              String          @id @default(uuid()) @db.Uuid
  authUserId      String          @unique @db.Uuid
  displayName     String?         @db.VarChar(100)
  preferredLocale String          @default("pt-BR") @db.VarChar(35)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  answers         ProfileAnswer[]
  processes       ImmigrationProcess[]

  @@schema("catalog")
}

// Quanto do país está coberto com conteúdo revisado (ADR 0001).
enum CoverageLevel {
  FULL
  PARTIAL
  LINKS_ONLY
  NONE

  @@schema("catalog")
}

// Só REVIEWED compõe checklist e página pública de requisitos (ADR 0001).
enum ReviewStatus {
  REVIEWED
  SOURCED_UNREVIEWED
  NEEDS_REVIEW
  DEPRECATED

  @@schema("catalog")
}

enum CountryStatus {
  ACTIVE
  COMING_SOON
  DISABLED
  @@schema("catalog")
}
enum VisaStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  @@schema("catalog")
}
enum SourceStatus {
  ACTIVE
  TEMPORARILY_UNAVAILABLE
  BROKEN
  ARCHIVED
  @@schema("catalog")
}
enum RequirementCategory {
  IDENTITY
  EMPLOYMENT
  EDUCATION
  FINANCIAL
  FAMILY
  HEALTH
  APPLICATION
  AFTER_ARRIVAL
  OTHER
  // Etapa de entrada no país (visto de entrada, condições de viagem).
  ENTRY
  @@schema("catalog")
}
enum RequirementType {
  DOCUMENT
  CONDITION
  ACTION
  INFORMATION
  FEE
  DEADLINE
  @@schema("catalog")
}
enum RequirementImportance {
  CRITICAL
  HIGH
  NORMAL
  LOW
  @@schema("catalog")
}
enum RequirementSourceType {
  PRIMARY
  SUPPORTING
  @@schema("catalog")
}
enum VisaSourceType {
  OVERVIEW
  APPLICATION
  FEES
  OFFICIAL_GUIDE
  @@schema("catalog")
}

model Country {
  id        String @id @default(cuid())
  code      String @unique @db.VarChar(2)
  slug      String @unique
  name      String
  status    CountryStatus @default(COMING_SOON)
  coverageLevel CoverageLevel @default(NONE)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  visas     Visa[]
  questions ProfileQuestion[]
  sources   OfficialSource[]
  @@schema("catalog")
}

model VisaCategory {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  visas       Visa[]
  @@schema("catalog")
}

model Visa {
  id               String @id @default(cuid())
  countryId        String
  categoryId       String
  slug             String
  name             String
  shortDescription String
  description      String?
  status           VisaStatus @default(DRAFT)
  officialName     String?
  authorityName    String?
  lastReviewedAt   DateTime? @db.Timestamptz(3)
  reviewStatus     ReviewStatus @default(SOURCED_UNREVIEWED)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  country          Country @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category         VisaCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requirements     VisaRequirement[]
  sources          VisaSource[]
  processes        ImmigrationProcess[]
  @@unique([countryId, slug])
  @@index([countryId, status, categoryId])
  @@index([categoryId])
  @@schema("catalog")
}

model VisaRequirement {
  id              String @id @default(cuid())
  visaId          String
  code            String
  title           String
  description     String
  category        RequirementCategory
  requirementType RequirementType
  importance      RequirementImportance @default(NORMAL)
  isMandatory     Boolean @default(false)
  sourceControlled Boolean @default(true)
  sortOrder       Int @default(0)
  reviewStatus    ReviewStatus @default(SOURCED_UNREVIEWED)
  lastVerifiedAt  DateTime? @db.Timestamptz(3)
  // Trecho literal curto da fonte oficial que sustenta o requisito.
  sourceQuote     String? @db.VarChar(500)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  visa            Visa @relation(fields: [visaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sources         RequirementSource[]
  checklistItems  ChecklistItem[]
  @@unique([visaId, code])
  @@index([visaId, sortOrder])
  @@schema("catalog")
}

model OfficialSource {
  id                           String @id @default(cuid())
  countryId                    String
  authority                    String
  title                        String
  url                          String
  hostname                     String
  status                       SourceStatus @default(ACTIVE)
  editorialConsultedAt          DateTime? @db.Timestamptz(3)
  lastVerifiedAt               DateTime? @db.Timestamptz(3)
  lastSuccessfulVerificationAt DateTime? @db.Timestamptz(3)
  verificationStatusCode       Int?
  verificationResolvedUrl      String?
  verificationDurationMs       Int?
  createdAt                    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime @updatedAt @db.Timestamptz(3)
  country                      Country @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requirements                 RequirementSource[]
  visas                        VisaSource[]
  checklistItems               ChecklistItemSource[]
  @@unique([countryId, url])
  @@index([hostname])
  @@schema("catalog")
}

model RequirementSource {
  requirementId String
  sourceId      String
  relationType  RequirementSourceType
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  requirement   VisaRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  source        OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@id([requirementId, sourceId])
  @@index([sourceId])
  @@schema("catalog")
}

model VisaSource {
  visaId       String
  sourceId     String
  relationType VisaSourceType
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  visa         Visa @relation(fields: [visaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  source       OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@id([visaId, sourceId])
  @@index([sourceId])
  @@schema("catalog")
}

// Questionário configurável por país (Fases 13 e 14). Perguntas e opções são
// catálogo público; respostas são privadas e pertencem ao UserProfile.
enum QuestionType {
  BOOLEAN
  SINGLE_SELECT
  MULTI_SELECT

  @@schema("catalog")
}

enum QuestionStatus {
  ACTIVE
  ARCHIVED

  @@schema("catalog")
}

model ProfileQuestion {
  id          String         @id @default(cuid())
  countryId   String
  code        String         @db.VarChar(80)
  question    String
  shortLabel  String?        @db.VarChar(60)
  description String?
  type        QuestionType
  required    Boolean        @default(true)
  sortOrder   Int            @default(0)
  status      QuestionStatus @default(ACTIVE)
  // Condição simples de exibição: { "questionCode": string, "equalsAnyOf": (string | boolean)[] }.
  showIf      Json?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  country     Country        @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  options     QuestionOption[]
  answers     ProfileAnswer[]

  @@unique([countryId, code])
  @@index([countryId, status, sortOrder])
  @@schema("catalog")
}

model QuestionOption {
  id          String          @id @default(cuid())
  questionId  String
  value       String          @db.VarChar(80)
  label       String
  description String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  question    ProfileQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([questionId, value])
  @@index([questionId, sortOrder])
  @@schema("catalog")
}

model ProfileAnswer {
  id            String          @id @default(uuid()) @db.Uuid
  userProfileId String          @db.Uuid
  questionId    String
  // Validado por Zod a partir do tipo da pergunta antes de gravar e ao ler.
  value         Json
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  userProfile   UserProfile     @relation(fields: [userProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  question      ProfileQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userProfileId, questionId])
  @@index([questionId])
  @@schema("catalog")
}


// Processos e checklists (Fases 19 a 24). Dados pessoais: pertencem ao
// UserProfile, acessados só pela credencial de perfil e sem grants públicos.
enum ProcessStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED

  @@schema("catalog")
}

enum ChecklistItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  NOT_APPLICABLE

  @@schema("catalog")
}

enum ChecklistStage {
  REQUIREMENTS
  APPLICATION
  ENTRY
  AFTER_ARRIVAL

  @@schema("catalog")
}

model ImmigrationProcess {
  id            String           @id @default(uuid()) @db.Uuid
  userProfileId String           @db.Uuid
  visaId        String
  title         String           @db.VarChar(120)
  status        ProcessStatus    @default(ACTIVE)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  userProfile   UserProfile      @relation(fields: [userProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  visa          Visa             @relation(fields: [visaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  snapshot      ProcessSnapshot?
  checklist     Checklist?

  @@index([userProfileId, status, updatedAt])
  @@index([visaId])
  @@schema("catalog")
}

// Contexto congelado no momento da criação: perfil normalizado, visto,
// requisitos revisados e versão das regras. Não muda depois.
model ProcessSnapshot {
  id                String             @id @default(uuid()) @db.Uuid
  processId         String             @unique @db.Uuid
  ruleEngineVersion String             @db.VarChar(40)
  promptVersion     String?            @db.VarChar(40)
  profile           Json
  visa              Json
  requirements      Json
  recommendation    Json?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  process           ImmigrationProcess @relation(fields: [processId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@schema("catalog")
}

model Checklist {
  id               String             @id @default(uuid()) @db.Uuid
  processId        String             @unique @db.Uuid
  generatorVersion String             @db.VarChar(40)
  // Data da revisão editorial do conteúdo usado para gerar o checklist.
  referenceDate    DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  process          ImmigrationProcess @relation(fields: [processId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items            ChecklistItem[]

  @@schema("catalog")
}

model ChecklistItem {
  id            String                @id @default(uuid()) @db.Uuid
  checklistId   String                @db.Uuid
  // Requisito de origem; nulo para itens pessoais ou requisito removido.
  requirementId String?
  code          String                @db.VarChar(80)
  stage         ChecklistStage
  title         String
  description   String
  status        ChecklistItemStatus   @default(PENDING)
  priority      RequirementImportance @default(NORMAL)
  isMandatory   Boolean               @default(false)
  isOfficial    Boolean               @default(true)
  sortOrder     Int                   @default(0)
  completedAt   DateTime?             @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  checklist     Checklist             @relation(fields: [checklistId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  requirement   VisaRequirement?      @relation(fields: [requirementId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sources       ChecklistItemSource[]

  @@unique([checklistId, code])
  @@index([checklistId, stage, sortOrder])
  @@index([requirementId])
  @@schema("catalog")
}

model ChecklistItemSource {
  itemId    String         @db.Uuid
  sourceId  String
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  item      ChecklistItem  @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  source    OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([itemId, sourceId])
  @@index([sourceId])
  @@schema("catalog")
}
