# As páginas estáticas e db:validate/db:generate não precisam destas variáveis.
# Configure valores reais SOMENTE em .env.local (ignorado pelo Git).
# Supabase: aplicação pooled, role de leitura; migrations/seed Session pooler (5432).
# Copie a URL no painel Connect; use sslmode=verify-full e acrescente &schema=catalog.
# Não habilite Data API para o schema catalog. Nunca cole credenciais na conversa.
DATABASE_URL=
# Role dedicada a dados pessoais (perfil, respostas, processos). Grants em docs/PENDENCIAS.md. Não usar DIRECT_URL.
# Mesmas exigências TLS e schema=catalog; ver docs/USER-PROFILE.md.
PROFILE_DATABASE_URL=
DIRECT_URL=
# Só na hospedagem (Vercel), onde não há arquivo de certificado: cole o texto
# PEM do certificado CA público do Supabase (SSL Configuration do projeto).
# Localmente deixe vazio e use sslrootcert na URL.
DATABASE_CA_CERT=
# Habilitar apenas no banco de desenvolvimento confirmado localmente.
DB_SEED_CONFIRM=

# Supabase Auth: chave pública publishable (sb_publishable_...), nunca secret/service_role.
# APP_ORIGIN: origem confiável, ex. http://localhost:3000 em desenvolvimento; HTTPS em produção.
# Configure templates de e-mail conforme docs/AUTHENTICATION.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=
# Chave secreta (sb_secret_...) usada SOMENTE no servidor para excluir a própria
# conta. Crie uma chave dedicada no painel (Settings > API Keys). Sem ela, a
# exclusão de conta fica indisponível e nada é apagado.
SUPABASE_SECRET_KEY=

# Configure SOMENTE em .env.test.local, não em .env.local:
# TEST_DATABASE_URL= Session pooler (5432) do projeto Supabase exclusivo de TESTE,
# com sslmode=verify-full&schema=catalog.
# DB_TEST_CONFIRM=supabase:IDENTIFICADOR_DO_PROJETO_DE_TESTE
# O banco hospedado se chama postgres; catalog deve estar vazio antes do teste.
